{%- set pageAbsUrl = site.baseUrl + "/" + (permalink if permalink != "index.html" else "") -%}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
{%- if useAbsoluteBase %}<base href="{{ site.baseUrl }}/">{%- endif %}
<meta name="description" content="{{ description }}">
<title>{{ title }}</title>
<link rel="icon" href="assets/images/logo.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="assets/images/logo.png">
<meta name="theme-color" content="#17372b">
{%- if noindex %}
<meta name="robots" content="noindex,follow">
{%- else %}
<meta name="robots" content="index,follow,max-image-preview:large">
{%- endif %}
<link rel="canonical" href="{{ pageAbsUrl }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="de_DE">
<meta property="og:site_name" content="Jungenwaldmühle">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ pageAbsUrl }}">
{%- if image %}
<meta property="og:image" content="{{ site.baseUrl }}/{{ image }}">
<meta property="og:image:width" content="{{ imageW }}">
<meta property="og:image:height" content="{{ imageH }}">
<meta property="og:image:alt" content="{{ imageAlt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.baseUrl }}/{{ image }}">
<meta name="twitter:image:alt" content="{{ imageAlt }}">
{%- endif %}
{%- if preloadHero %}<link rel="preload" as="image" href="{{ image }}"{% if imageSrcset %} imagesrcset="{{ imageSrcset }}" imagesizes="{{ imageSizes or '100vw' }}"{% endif %} fetchpriority="high">{%- endif %}
<link rel="stylesheet" href="assets/styles.css?v=20260828-2">
<link rel="stylesheet" href="assets/styles-polish.css?v=20260828-2">
</head>
<body>
<a class="skip" href="#main">Zum Inhalt springen</a>
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="index.html" aria-label="Jungenwaldmühle – Startseite">
      <img src="assets/images/logo.svg" alt="" width="52" height="52">
      <span><strong>Jungenwaldmühle</strong><small>Restaurant · Hofcafé · Ponyhof</small></span>
    </a>
    <button class="toggle" type="button" aria-label="Navigation öffnen" aria-expanded="false" aria-controls="nav"><span></span><span></span></button>
    <nav class="links" id="nav" aria-label="Hauptnavigation">
      <div class="nav-primary">
      {% for item in site.nav %}<a href="{{ item.href }}"{% if item.key == navKey %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
      </div>
      <a class="nav-reserve" href="tel:+4965347493854"><span>Tisch reservieren</span><strong class="phone-number">06534 7493854</strong></a>
    </nav>
  </div>
</header>
{{ content | safe }}
<button class="scroll-top" type="button" aria-label="Zum Seitenanfang" title="Nach oben" tabindex="-1">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6.5 10.5 12 5l5.5 5.5"/></svg>
</button>
<footer class="footer">
  <div class="container footer-lead">
    <a class="footer-brand" href="index.html" aria-label="Jungenwaldmühle – Startseite">
      <img src="assets/images/logo.svg" alt="" width="64" height="64">
      <span>Jungenwaldmühle</span>
    </a>
    <p class="kicker">Jungenwaldmühle bei Brauneberg</p>
    <h2>Ein guter Grund,<br>von der Mosel abzubiegen.</h2>
    <a class="btn btn-light btn-call" href="tel:+4965347493854" aria-label="Tisch telefonisch reservieren">Tisch reservieren</a>
  </div>
  <div class="container footer-grid">
    <div><strong>Jungenwaldmühle 1</strong><br>54472 Brauneberg<br><a href="https://www.google.com/maps/dir/?api=1&destination=Jungenwaldm%C3%BChle%201%2C%2054472%20Brauneberg">Route öffnen</a></div>
    <div><strong>Restaurant & Hofcafé</strong><br>Apr–Okt · Sa–Di<br>Nov–Mär · Sa–So<br>11:30–21:00 Uhr</div>
    <div><strong>Kontakt</strong><br><a href="tel:+4965347493854"><span class="phone-number">06534 7493854</span></a><br><a href="mailto:jungenwaldmuehle1@gmail.com">E-Mail schreiben</a></div>
  </div>
  <div class="container legal">© <span data-year></span> Jungenwaldmühle · <a href="impressum.html">Impressum & Datenschutz</a></div>
</footer>
<script src="assets/app.js?v=20260828-2"></script>
{%- if not noindex %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Restaurant",
      "@id": "{{ site.baseUrl }}/#restaurant",
      "name": "Jungenwaldmühle",
      "alternateName": "Restaurant & Hofcafé Jungenwaldmühle",
      "description": "Historische Wassermühle mit Restaurant, Hofcafé und Ponyhof bei Brauneberg an der Mosel.",
      "url": "{{ site.baseUrl }}/",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.baseUrl }}/assets/images/logo.png"
      },
      "image": [
        {
          "@type": "ImageObject",
          "url": "{{ site.baseUrl }}/assets/images/terrace-enhanced.webp"
        },
        {
          "@type": "ImageObject",
          "url": "{{ site.baseUrl }}/assets/images/restaurant-fireplace.jpg"
        }
      ],
      "telephone": "+4965347493854",
      "email": "jungenwaldmuehle1@gmail.com",
      "servesCuisine": ["Regionale deutsche Küche", "Hausgemachte Kuchen"],
      "acceptsReservations": true,
      "hasMenu": "{{ site.baseUrl }}/restaurant.html#speisekarte",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jungenwaldmühle 1",
        "postalCode": "54472",
        "addressLocality": "Brauneberg",
        "addressRegion": "Rheinland-Pfalz",
        "addressCountry": "DE"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday", "Sunday", "Monday", "Tuesday"],
          "opens": "11:30",
          "closes": "21:00",
          "validFrom": "2026-04-01",
          "validThrough": "2026-10-31"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday", "Sunday"],
          "opens": "11:30",
          "closes": "21:00",
          "validFrom": "2026-11-01",
          "validThrough": "2027-03-31"
        }
      ],
      "hasMap": "https://www.google.com/maps/search/?api=1&query=Jungenwaldm%C3%BChle%201%2C%2054472%20Brauneberg",
      "sameAs": [
        "https://jungenwaldmuehle.simdif.com/",
        "https://www.visitmosel.de/gastgeber-arrangements/poi/jungenwaldmuehle"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.baseUrl }}/#website",
      "url": "{{ site.baseUrl }}/",
      "name": "Jungenwaldmühle",
      "inLanguage": "de-DE",
      "publisher": {"@id": "{{ site.baseUrl }}/#restaurant"}
    },
    {
      "@type": "WebPage",
      "@id": "{{ pageAbsUrl }}#webpage",
      "url": "{{ pageAbsUrl }}",
      "name": "{{ title | safe }}",
      "description": "{{ description | safe }}",
      "inLanguage": "de-DE",
      "isPartOf": {"@id": "{{ site.baseUrl }}/#website"},
      "about": {"@id": "{{ site.baseUrl }}/#restaurant"},
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "{{ site.baseUrl }}/{{ image }}",
        "caption": "{{ imageAlt | safe }}"
      }
    }{% if breadcrumb %},
    {
      "@type": "BreadcrumbList",
      "@id": "{{ pageAbsUrl }}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Startseite",
          "item": "{{ site.baseUrl }}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ breadcrumb | safe }}",
          "item": "{{ pageAbsUrl }}"
        }
      ]
    }{% endif %}
  ]
}
</script>
{%- endif %}
</body>
</html>
